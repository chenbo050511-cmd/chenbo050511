# 依赖
node_modules/

# ---------------------------------------------------------------------------
# 你的学习数据 —— 绝对不要提交
#
# 早期版本写的是 `data/*.db`，它匹配不到那些手工备份
# （wordmaster.db.before-extra 之类，每个都含同样的学习记录、加起来 ~35MB）。
# 所以这里直接忽略整个 data/ 目录，只放行不要提交东西的占位文件。
# ---------------------------------------------------------------------------
data/
!data/.gitkeep

# 构建产物 / 原始语料（200MB+，而且能重新下载）
tools/_raw/
dist/

# 日志与临时文件
*.log
*.err
*.pid
_tmp_*
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/
*.swp
